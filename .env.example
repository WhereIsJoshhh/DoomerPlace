PORT=3000
NODE_ENV=development
API_PREFIX=api/v1

# PostgreSQL Database Connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/marketplace_db?schema=public"

# JWT Authentication
JWT_SECRET="super-secret-marketplace-jwt-access-key-2026"
JWT_EXPIRATION="15m"
JWT_REFRESH_SECRET="super-secret-marketplace-jwt-refresh-key-2026"
JWT_REFRESH_EXPIRATION="7d"

# Redis Cache & Concurrency Locks
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# Search Engine (Meilisearch / Typesense)
SEARCH_HOST="http://localhost:7700"
SEARCH_MASTER_KEY="MasterSearchKey2026!"

# Business Logic Configuration
RESERVATION_TTL_MINUTES=15
DEFAULT_COMMISSION_PERCENT=10.0
ESCROW_HOLD_DAYS=7

# Amazon Creators API (PA-API 5.0 has been retired)
AMAZON_CREATORS_CLIENT_ID=
AMAZON_CREATORS_CLIENT_SECRET=
AMAZON_CREATORS_TOKEN_URL=https://api.amazon.com/auth/o2/token
AMAZON_PARTNER_TAG=
AMAZON_MARKETPLACE=www.amazon.com
# Existing marketplace records; do not invent IDs. Create/select a real store and category.
AMAZON_INTEGRATION_STORE_ID=
AMAZON_DEFAULT_CATEGORY_ID=
# Set to 0 to disable scheduled sync, or the interval in hours (for example 6).
AMAZON_SYNC_INTERVAL_HOURS=0
