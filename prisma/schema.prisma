// Prisma Schema for Multi-Vendor Marketplace Backend
// Covers the 14 Domains specified in the Technical Architecture Document

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS
// ==========================================

enum EstadoUsuario {
  ACTIVO
  INACTIVO
  SUSPENDIDO
}

enum AccionPermiso {
  CREAR
  LEER
  ACTUALIZAR
  ELIMINAR
  APROBAR
}

enum TipoDireccion {
  ENVIO
  FACTURACION
}

enum EstadoVendedor {
  PENDIENTE
  APROBADO
  RECHAZADO
  SUSPENDIDO
}

enum TipoPersona {
  NATURAL
  JURIDICA
}

enum EstadoDocumento {
  PENDIENTE
  APROBADO
  RECHAZADO
}

enum TipoProducto {
  SIMPLE
  VARIABLE
}

enum EstadoProducto {
  BORRADOR
  ACTIVO
  INACTIVO
  ARCHIVADO
}

enum TipoMovimientoInventario {
  ENTRADA_COMPRA
  SALIDA_VENTA
  AJUSTE_POSITIVO
  AJUSTE_NEGATIVO
  RESERVA_CHECKOUT
  LIBERACION_RESERVA
  DEVOLUCION_RMA
}

enum EstadoCarrito {
  ACTIVO
  ABANDONADO
  CONVERTIDO
}

enum EstadoPedido {
  PENDIENTE_PAGO
  PAGADO
  EN_PROCESO
  COMPLETADO
  CANCELADO
  REEMBOLSADO
}

enum EstadoSubPedido {
  PENDIENTE
  CONFIRMADO
  EN_PREPARACION
  ENVIADO
  ENTREGADO
  CANCELADO
  EN_DISPUTA
}

enum EstadoPago {
  PENDIENTE
  APROBADO
  RECHAZADO
  REEMBOLSADO
  EXPIRADO
}

enum EstadoLiquidacion {
  PENDIENTE
  PROCESANDO
  PAGADA
  RECHAZADA
}

enum EstadoEnvio {
  PENDIENTE
  GUIA_GENERADA
  EN_TRANSITO
  EN_REPARTO
  ENTREGADO
  FALLIDO
  DEVUELTO
}

enum EstadoDevolucion {
  SOLICITADA
  EN_REVISION
  APROBADA
  RECHAZADA
  COMPLETADA
}

enum InspeccionEstado {
  PENDIENTE
  CONFORME
  DEFECTUOSO_CLIENTE
  DEFECTUOSO_FABRICA
}

enum TipoDescuento {
  PORCENTAJE
  MONTO_FIJO
}

enum CanalNotificacion {
  EMAIL
  PUSH
  SMS
  IN_APP
}

// ==========================================
// DOMINIO 1: IDENTIDAD, USUARIOS Y RBAC
// ==========================================

model Usuario {
  id                 String        @id @default(uuid())
  nombre             String
  apellido           String
  email              String        @unique
  telefono           String?
  passwordHash       String
  emailVerificado    Boolean       @default(false)
  telefonoVerificado Boolean       @default(false)
  estado             EstadoUsuario @default(ACTIVO)
  ultimoAcceso       DateTime?
  fechaRegistro      DateTime      @default(now())
  fechaActualizacion DateTime      @updatedAt

  // Relaciones
  roles               UsuarioRol[]
  direcciones         Direccion[]
  vendedor            Vendedor?
  carritos            Carrito[]
  pedidos             Pedido[]
  resenasProductos    ResenaProducto[]
  resenasTiendas      ResenaTienda[]
  listasDeseos        ListaDeseos[]
  preguntas           PreguntaProducto[]
  respuestas          RespuestaPregunta[]
  mensajes            Mensaje[]
  notificaciones      Notificacion[]
  auditorias          Auditoria[]
  movimientosKardex   MovimientoInventario[]
  historialesPedidos  HistorialEstadoPedido[]
  devoluciones        Devolucion[]
  cuponesUsados       CuponUso[]

  @@index([email])
  @@index([estado])
  @@map("usuarios")
}

model Rol {
  id          String   @id @default(uuid())
  nombre      String
  slug        String   @unique
  descripcion String?
  esSistema   Boolean  @default(false)
  estado      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relaciones
  usuarios UsuarioRol[]
  permisos RolPermiso[]

  @@index([slug])
  @@map("roles")
}

model Permiso {
  id          String        @id @default(uuid())
  nombre      String
  modulo      String
  accion      AccionPermiso
  descripcion String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Relaciones
  roles RolPermiso[]

  @@unique([modulo, accion])
  @@index([modulo])
  @@map("permisos")
}

model UsuarioRol {
  id              String   @id @default(uuid())
  usuarioId       String
  rolId           String
  fechaAsignacion DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  rol     Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, rolId])
  @@index([usuarioId])
  @@index([rolId])
  @@map("usuarios_roles")
}

model RolPermiso {
  id        String   @id @default(uuid())
  rolId     String
  permisoId String
  createdAt DateTime @default(now())

  rol     Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)
  permiso Permiso @relation(fields: [permisoId], references: [id], onDelete: Cascade)

  @@unique([rolId, permisoId])
  @@index([rolId])
  @@index([permisoId])
  @@map("roles_permisos")
}

model Direccion {
  id            String        @id @default(uuid())
  usuarioId     String
  tipo          TipoDireccion
  alias         String?
  receptor      String
  telefono      String
  pais          String
  departamento  String
  ciudad        String
  colonia       String?
  calle         String
  referencia    String?
  codigoPostal  String
  latitud       Decimal?      @db.Decimal(10, 8)
  longitud      Decimal?      @db.Decimal(11, 8)
  esPrincipal   Boolean       @default(false)
  fechaRegistro DateTime      @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  pedidosEnvio        Pedido[]    @relation("PedidoDireccionEnvio")
  pedidosFacturacion  Pedido[]    @relation("PedidoDireccionFacturacion")
  enviosLogisticos    Envio[]

  @@index([usuarioId])
  @@index([tipo, esPrincipal])
  @@map("direcciones")
}

// ==========================================
// DOMINIO 2: VENDEDORES, TIENDAS Y ONBOARDING (KYC)
// ==========================================

model Vendedor {
  id                     String         @id @default(uuid())
  usuarioId              String         @unique
  razonSocial            String
  nombreComercial        String
  identificacionFiscal   String         @unique
  tipoPersona            TipoPersona    @default(NATURAL)
  telefonoComercial      String
  emailComercial         String
  estado                 EstadoVendedor @default(PENDIENTE)
  porcentajeComisionBase Decimal        @default(10.00) @db.Decimal(5, 2)
  calificacionPromedio   Decimal        @default(0.00) @db.Decimal(3, 2)
  fechaSolicitud         DateTime       @default(now())
  fechaAprobacion        DateTime?

  usuario         Usuario              @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  tienda          Tienda?
  documentos      DocumentoVendedor[]
  cuentasBancarias CuentaBancariaVendedor[]
  balance         BalanceVendedor?
  liquidaciones   LiquidacionVendedor[]

  @@index([estado])
  @@map("vendedores")
}

model Tienda {
  id                  String   @id @default(uuid())
  vendedorId          String   @unique
  nombre              String
  slug                String   @unique
  lema                String?
  descripcion         String?
  logoUrl             String?
  bannerUrl           String?
  telefono            String?
  email               String?
  direccionFisica     String?
  horarioAtencion     String?
  politicasDevolucion String?
  estado              Boolean  @default(true)
  fechaCreacion       DateTime @default(now())

  vendedor      Vendedor       @relation(fields: [vendedorId], references: [id], onDelete: Cascade)
  productos     Producto[]
  subPedidos    SubPedido[]
  cupones       Cupon[]
  resenas       ResenaTienda[]
  conversaciones Conversacion[]

  @@index([slug])
  @@map("tiendas")
}

model DocumentoVendedor {
  id                    String          @id @default(uuid())
  vendedorId            String
  tipoDocumento         String
  numeroDocumento       String
  archivoUrl            String
  estado                EstadoDocumento @default(PENDIENTE)
  observacionesRevision String?
  revisadoPorUsuarioId  String?
  fechaSubida           DateTime        @default(now())
  fechaRevision         DateTime?

  vendedor Vendedor @relation(fields: [vendedorId], references: [id], onDelete: Cascade)

  @@index([vendedorId])
  @@map("documentos_vendedores")
}

// ==========================================
// DOMINIO 3: CATÁLOGO DE PRODUCTOS Y VARIANTES
// ==========================================

model Categoria {
  id               String      @id @default(uuid())
  categoriaPadreId String?
  nombre           String
  slug             String      @unique
  descripcion      String?
  imagenUrl        String?
  icono            String?
  nivel            Int         @default(1)
  orden            Int         @default(0)
  estado           Boolean     @default(true)

  categoriaPadre Categoria?  @relation("JerarquiaCategorias", fields: [categoriaPadreId], references: [id])
  subcategorias  Categoria[] @relation("JerarquiaCategorias")
  productos      Producto[]
  atributos      Atributo[]

  @@index([categoriaPadreId])
  @@index([slug])
  @@map("categorias")
}

model Marca {
  id          String   @id @default(uuid())
  nombre      String
  slug        String   @unique
  descripcion String?
  logoUrl     String?
  sitioWeb    String?
  estado      Boolean  @default(true)

  productos Producto[]

  @@index([slug])
  @@map("marcas")
}

model Producto {
  id                String         @id @default(uuid())
  tiendaId          String
  categoriaId       String
  marcaId           String?
  nombre            String
  slug              String         @unique
  descripcionCorta  String?
  descripcionLarga  String?
  skuBase           String         @unique
  tipoProducto      TipoProducto   @default(SIMPLE)
  peso              Decimal        @default(0.000) @db.Decimal(8, 3)
  ancho             Decimal        @default(0.00) @db.Decimal(8, 2)
  alto              Decimal        @default(0.00) @db.Decimal(8, 2)
  largo             Decimal        @default(0.00) @db.Decimal(8, 2)
  requiereEnvio     Boolean        @default(true)
  estado            EstadoProducto @default(BORRADOR)
  esDestacado       Boolean        @default(false)
  fechaPublicacion  DateTime?
  fechaActualizacion DateTime      @updatedAt

  tienda     Tienda             @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  categoria  Categoria          @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  marca      Marca?             @relation(fields: [marcaId], references: [id], onDelete: SetNull)
  imagenes   ProductoImagen[]
  variantes  ProductoVariante[]
  atributos  ProductoAtributo[]
  inventario Inventario?
  resenas    ResenaProducto[]
  preguntas  PreguntaProducto[]
    amazonImport AmazonProductImport?
    externalImports ExternalProductImport[]

  @@index([tiendaId])
  @@index([categoriaId])
  @@index([estado])
  @@map("productos")
}

model ExternalProductImport {
  id            String   @id @default(uuid())
  provider      String
  externalId    String
  productoId    String
  originalUrl   String
  sellerName    String?
  condition     String?
  available     Boolean  @default(false)
  externalPrice Decimal? @db.Decimal(12, 2)
  currency      String?
  lastSyncedAt  DateTime?
  lastSyncError String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  producto Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@index([productoId])
  @@index([lastSyncedAt])
  @@map("external_product_imports")
}

model AmazonProductImport {
  id              String   @id @default(uuid())
  asin            String   @unique
  productoId      String   @unique
  affiliateUrl    String
  available       Boolean  @default(false)
  externalPrice   Decimal? @db.Decimal(12, 2)
  currency        String?
  lastSyncedAt    DateTime?
  lastSyncError   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  producto Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@index([lastSyncedAt])
  @@map("amazon_product_imports")
}

model ProductoImagen {
  id          String  @id @default(uuid())
  productoId  String
  varianteId  String?
  url         String
  altText     String?
  orden       Int     @default(0)
  esPrincipal Boolean @default(false)

  producto Producto          @relation(fields: [productoId], references: [id], onDelete: Cascade)
  variante ProductoVariante? @relation(fields: [varianteId], references: [id], onDelete: SetNull)

  @@index([productoId])
  @@index([varianteId])
  @@map("productos_imagenes")
}

model Atributo {
  id            String   @id @default(uuid())
  categoriaId   String?
  nombre        String
  tipoDato      String   @default("TEXTO")
  esObligatorio Boolean  @default(false)
  esFiltrable   Boolean  @default(true)
  esVariante    Boolean  @default(true)

  categoria Categoria?         @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  valores   ValorAtributo[]
  variantes VarianteAtributo[]
  productos ProductoAtributo[]

  @@index([categoriaId])
  @@map("atributos")
}

model ValorAtributo {
  id         String  @id @default(uuid())
  atributoId String
  valor      String
  codigoHex  String?
  orden      Int     @default(0)

  atributo   Atributo           @relation(fields: [atributoId], references: [id], onDelete: Cascade)
  variantes  VarianteAtributo[]
  productos  ProductoAtributo[]

  @@index([atributoId])
  @@map("valores_atributos")
}

model ProductoVariante {
  id                String   @id @default(uuid())
  productoId        String
  sku               String   @unique
  nombreVariante    String
  precio            Decimal  @db.Decimal(12, 2)
  precioComparacion Decimal? @db.Decimal(12, 2)
  costo             Decimal? @db.Decimal(12, 2)
  peso              Decimal? @db.Decimal(8, 3)
  codigoBarras      String?
  estado            Boolean  @default(true)

  producto   Producto           @relation(fields: [productoId], references: [id], onDelete: Cascade)
  atributos  VarianteAtributo[]
  imagenes   ProductoImagen[]
  inventario Inventario?

  @@index([productoId])
  @@index([sku])
  @@map("productos_variantes")
}

model VarianteAtributo {
  id              String @id @default(uuid())
  varianteId      String
  atributoId      String
  valorAtributoId String

  variante      ProductoVariante @relation(fields: [varianteId], references: [id], onDelete: Cascade)
  atributo      Atributo         @relation(fields: [atributoId], references: [id], onDelete: Restrict)
  valorAtributo ValorAtributo    @relation(fields: [valorAtributoId], references: [id], onDelete: Restrict)

  @@unique([varianteId, atributoId])
  @@index([varianteId])
  @@map("variantes_atributos")
}

model ProductoAtributo {
  id                     String  @id @default(uuid())
  productoId             String
  atributoId             String
  valorAtributoId        String?
  valorTextoPersonalizado String?

  producto      Producto       @relation(fields: [productoId], references: [id], onDelete: Cascade)
  atributo      Atributo       @relation(fields: [atributoId], references: [id], onDelete: Restrict)
  valorAtributo ValorAtributo? @relation(fields: [valorAtributoId], references: [id], onDelete: SetNull)

  @@index([productoId])
  @@map("productos_atributos")
}

// ==========================================
// DOMINIO 4: INVENTARIO Y KARDEX
// ==========================================

model Inventario {
  id                 String   @id @default(uuid())
  productoId         String?  @unique
  varianteId         String?  @unique
  stockFisico        Int      @default(0)
  stockReservado     Int      @default(0)
  stockDisponible    Int      @default(0)
  stockMinimoAlerta  Int      @default(5)
  permitirSobreventa Boolean  @default(false)
  fechaActualizacion DateTime @updatedAt

  producto    Producto?              @relation(fields: [productoId], references: [id], onDelete: Cascade)
  variante    ProductoVariante?      @relation(fields: [varianteId], references: [id], onDelete: Cascade)
  movimientos MovimientoInventario[]

  @@map("inventarios")
}

model MovimientoInventario {
  id             String                   @id @default(uuid())
  inventarioId   String
  tipo           TipoMovimientoInventario
  cantidad       Int
  stockAnterior  Int
  stockNuevo     Int
  motivo         String
  referenciaTipo String?
  referenciaId   String?
  usuarioId      String?
  fecha          DateTime                 @default(now())

  inventario Inventario @relation(fields: [inventarioId], references: [id], onDelete: Cascade)
  usuario    Usuario?   @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([inventarioId])
  @@index([referenciaTipo, referenciaId])
  @@map("movimientos_inventario")
}

// ==========================================
// DOMINIO 5: CARRITO DE COMPRAS
// ==========================================

model Carrito {
  id                 String        @id @default(uuid())
  usuarioId          String?
  tokenSesion        String?       @unique
  estado             EstadoCarrito @default(ACTIVO)
  expiraEn           DateTime
  fechaCreacion      DateTime      @default(now())
  fechaActualizacion DateTime      @updatedAt

  usuario Usuario?      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  items   CarritoItem[]

  @@index([usuarioId])
  @@index([tokenSesion])
  @@map("carritos")
}

model CarritoItem {
  id                String   @id @default(uuid())
  carritoId         String
  productoId        String
  varianteId        String?
  tiendaId          String
  cantidad          Int
  precioUnitario    Decimal  @db.Decimal(12, 2)
  subtotalCalculado Decimal  @db.Decimal(12, 2)
  fechaAgregado     DateTime @default(now())

  carrito Carrito @relation(fields: [carritoId], references: [id], onDelete: Cascade)

  @@index([carritoId])
  @@map("carritos_items")
}

// ==========================================
// DOMINIO 6: GESTIÓN DE PEDIDOS Y SPLIT ORDERS
// ==========================================

model Pedido {
  id                    String       @id @default(uuid())
  usuarioId             String
  numeroPedido          String       @unique
  direccionEnvioId      String
  direccionFacturacionId String
  subtotal              Decimal      @db.Decimal(12, 2)
  descuentoTotal        Decimal      @default(0.00) @db.Decimal(12, 2)
  impuestoTotal         Decimal      @default(0.00) @db.Decimal(12, 2)
  costoEnvioTotal       Decimal      @default(0.00) @db.Decimal(12, 2)
  total                 Decimal      @db.Decimal(12, 2)
  moneda                String       @default("USD")
  estado                EstadoPedido @default(PENDIENTE_PAGO)
  cuponId               String?
  ipCliente             String?
  fechaCreacion         DateTime     @default(now())
  fechaActualizacion    DateTime     @updatedAt

  usuario              Usuario                 @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  direccionEnvio       Direccion               @relation("PedidoDireccionEnvio", fields: [direccionEnvioId], references: [id], onDelete: Restrict)
  direccionFacturacion Direccion               @relation("PedidoDireccionFacturacion", fields: [direccionFacturacionId], references: [id], onDelete: Restrict)
  subPedidos           SubPedido[]
  items                PedidoItem[]
  historialEstados     HistorialEstadoPedido[]
  pagos                Pago[]

  @@index([numeroPedido])
  @@index([usuarioId])
  @@index([estado])
  @@map("pedidos")
}

model SubPedido {
  id                      String          @id @default(uuid())
  pedidoId                String
  tiendaId                String
  numeroSubPedido         String          @unique
  subtotal                Decimal         @db.Decimal(12, 2)
  descuento               Decimal         @default(0.00) @db.Decimal(12, 2)
  impuesto                Decimal         @default(0.00) @db.Decimal(12, 2)
  costoEnvio              Decimal         @default(0.00) @db.Decimal(12, 2)
  total                   Decimal         @db.Decimal(12, 2)
  porcentajeComision      Decimal         @db.Decimal(5, 2)
  montoComisionPlataforma Decimal         @db.Decimal(12, 2)
  montoNetoTienda         Decimal         @db.Decimal(12, 2)
  estado                  EstadoSubPedido @default(PENDIENTE)
  fechaActualizacion      DateTime        @updatedAt

  pedido           Pedido                       @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  tienda           Tienda                       @relation(fields: [tiendaId], references: [id], onDelete: Restrict)
  items            PedidoItem[]
  historialEstados HistorialEstadoPedido[]
  envio            Envio?
  devoluciones     Devolucion[]
  liquidaciones    DetalleLiquidacionSubPedido[]

  @@index([pedidoId])
  @@index([tiendaId])
  @@index([estado])
  @@map("subpedidos")
}

model PedidoItem {
  id                     String   @id @default(uuid())
  pedidoId               String
  subPedidoId            String
  productoId             String
  varianteId             String?
  nombreProductoSnapshot String
  skuSnapshot            String
  precioUnitario         Decimal  @db.Decimal(12, 2)
  costoUnitario          Decimal? @db.Decimal(12, 2)
  cantidad               Int
  descuento              Decimal  @default(0.00) @db.Decimal(12, 2)
  impuesto               Decimal  @default(0.00) @db.Decimal(12, 2)
  subtotal               Decimal  @db.Decimal(12, 2)

  pedido           Pedido           @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  subPedido        SubPedido        @relation(fields: [subPedidoId], references: [id], onDelete: Cascade)
  devolucionItems  DevolucionItem[]
  resenaProducto   ResenaProducto?

  @@index([pedidoId])
  @@index([subPedidoId])
  @@map("pedidos_items")
}

model HistorialEstadoPedido {
  id                   String   @id @default(uuid())
  pedidoId             String
  subPedidoId          String?
  estadoAnterior       String
  estadoNuevo          String
  comentario           String?
  cambiadoPorUsuarioId String?
  fecha                DateTime @default(now())

  pedido              Pedido     @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  subPedido           SubPedido? @relation(fields: [subPedidoId], references: [id], onDelete: Cascade)
  cambiadoPorUsuario  Usuario?   @relation(fields: [cambiadoPorUsuarioId], references: [id], onDelete: SetNull)

  @@index([pedidoId])
  @@index([subPedidoId])
  @@map("historial_estados_pedidos")
}

// ==========================================
// DOMINIO 7: PAGOS Y PASARELAS
// ==========================================

model MetodoPago {
  id               String   @id @default(uuid())
  codigo           String   @unique
  nombre           String
  descripcion      String?
  esPasarelaOnline Boolean  @default(true)
  activo           Boolean  @default(true)

  pagos Pago[]

  @@map("metodos_pago")
}

model Pago {
  id                     String     @id @default(uuid())
  pedidoId               String
  metodoPagoId           String
  transaccionExternaId   String?    @unique
  monto                  Decimal    @db.Decimal(12, 2)
  moneda                 String     @default("USD")
  estado                 EstadoPago @default(PENDIENTE)
  codigoAutorizacion     String?
  datosRespuestaPasarela Json?
  fechaPago              DateTime?
  fechaExpiracion        DateTime?
  createdAt              DateTime   @default(now())

  pedido     Pedido      @relation(fields: [pedidoId], references: [id], onDelete: Restrict)
  metodoPago MetodoPago  @relation(fields: [metodoPagoId], references: [id], onDelete: Restrict)
  reembolsos Reembolso[]

  @@index([pedidoId])
  @@index([transaccionExternaId])
  @@index([estado])
  @@map("pagos")
}

// ==========================================
// DOMINIO 8: FINANZAS, COMISIONES Y PAYOUTS
// ==========================================

model CuentaBancariaVendedor {
  id                   String   @id @default(uuid())
  vendedorId           String
  banco                String
  tipoCuenta           String
  numeroCuenta         String
  titularCuenta        String
  identificacionTitular String
  esPrincipal          Boolean  @default(false)
  estado               Boolean  @default(true)
  fechaRegistro        DateTime @default(now())

  vendedor      Vendedor              @relation(fields: [vendedorId], references: [id], onDelete: Cascade)
  liquidaciones LiquidacionVendedor[]

  @@index([vendedorId])
  @@map("cuentas_bancarias_vendedores")
}

model BalanceVendedor {
  id                 String   @id @default(uuid())
  vendedorId         String   @unique
  saldoPendiente     Decimal  @default(0.00) @db.Decimal(12, 2)
  saldoDisponible    Decimal  @default(0.00) @db.Decimal(12, 2)
  saldoRetirado      Decimal  @default(0.00) @db.Decimal(12, 2)
  fechaActualizacion DateTime @updatedAt

  vendedor Vendedor @relation(fields: [vendedorId], references: [id], onDelete: Cascade)

  @@map("balances_vendedores")
}

model LiquidacionVendedor {
  id                         String            @id @default(uuid())
  vendedorId                 String
  cuentaBancariaId           String
  numeroLiquidacion          String            @unique
  periodoInicio              DateTime
  periodoFin                 DateTime
  totalVentasBrutas          Decimal           @db.Decimal(12, 2)
  totalComisionesDescontadas Decimal           @db.Decimal(12, 2)
  totalEnviosReembolsados    Decimal           @default(0.00) @db.Decimal(12, 2)
  totalRetencionesFiscales   Decimal           @default(0.00) @db.Decimal(12, 2)
  montoNetoPagar             Decimal           @db.Decimal(12, 2)
  estado                     EstadoLiquidacion @default(PENDIENTE)
  referenciaBancaria         String?
  comprobanteUrl             String?
  fechaPago                  DateTime?
  procesadoPorUsuarioId      String?
  createdAt                  DateTime          @default(now())

  vendedor       Vendedor                      @relation(fields: [vendedorId], references: [id], onDelete: Restrict)
  cuentaBancaria CuentaBancariaVendedor        @relation(fields: [cuentaBancariaId], references: [id], onDelete: Restrict)
  detalles       DetalleLiquidacionSubPedido[]

  @@index([vendedorId])
  @@index([numeroLiquidacion])
  @@map("liquidaciones_vendedores")
}

model DetalleLiquidacionSubPedido {
  id            String  @id @default(uuid())
  liquidacionId String
  subPedidoId   String
  montoLiberado Decimal @db.Decimal(12, 2)

  liquidacion LiquidacionVendedor @relation(fields: [liquidacionId], references: [id], onDelete: Cascade)
  subPedido   SubPedido           @relation(fields: [subPedidoId], references: [id], onDelete: Restrict)

  @@unique([liquidacionId, subPedidoId])
  @@map("detalles_liquidaciones_subpedidos")
}

// ==========================================
// DOMINIO 9: LOGÍSTICA Y ENVÍOS MULTI-TIENDA
// ==========================================

model Envio {
  id                   String      @id @default(uuid())
  subPedidoId          String      @unique
  direccionEnvioId     String
  proveedorLogistico   String
  numeroGuia           String?     @unique
  urlTracking          String?
  costoRealEnvio       Decimal     @db.Decimal(12, 2)
  pesoTotal            Decimal     @db.Decimal(8, 3)
  fechaDespacho        DateTime?
  fechaEstimadaEntrega DateTime?
  fechaEntregaReal     DateTime?
  estado               EstadoEnvio @default(PENDIENTE)

  subPedido      SubPedido        @relation(fields: [subPedidoId], references: [id], onDelete: Cascade)
  direccionEnvio Direccion        @relation(fields: [direccionEnvioId], references: [id], onDelete: Restrict)
  eventos        EventoTracking[]

  @@index([numeroGuia])
  @@index([estado])
  @@map("envios")
}

model EventoTracking {
  id          String   @id @default(uuid())
  envioId     String
  estadoHito  String
  ubicacion   String?
  descripcion String
  fechaEvento DateTime @default(now())

  envio Envio @relation(fields: [envioId], references: [id], onDelete: Cascade)

  @@index([envioId])
  @@map("eventos_tracking")
}

// ==========================================
// DOMINIO 10: DEVOLUCIONES, GARANTÍAS Y REEMBOLSOS (RMA)
// ==========================================

model Devolucion {
  id              String           @id @default(uuid())
  subPedidoId     String
  usuarioId       String
  motivo          String
  descripcion     String?
  estado          EstadoDevolucion @default(SOLICITADA)
  fechaSolicitud  DateTime         @default(now())
  fechaResolucion DateTime?

  subPedido  SubPedido        @relation(fields: [subPedidoId], references: [id], onDelete: Restrict)
  usuario    Usuario          @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  items      DevolucionItem[]
  reembolsos Reembolso[]

  @@index([subPedidoId])
  @@index([usuarioId])
  @@map("devoluciones")
}

model DevolucionItem {
  id               String           @id @default(uuid())
  devolucionId     String
  pedidoItemId     String
  cantidad         Int
  inspeccionEstado InspeccionEstado @default(PENDIENTE)

  devolucion Devolucion @relation(fields: [devolucionId], references: [id], onDelete: Cascade)
  pedidoItem PedidoItem @relation(fields: [pedidoItemId], references: [id], onDelete: Restrict)

  @@map("devoluciones_items")
}

model Reembolso {
  id                          String   @id @default(uuid())
  pagoId                      String
  devolucionId                String?
  monto                       Decimal  @db.Decimal(12, 2)
  moneda                      String   @default("USD")
  transaccionReembolsoExternaId String?  @unique
  motivo                      String?
  estado                      String   @default("COMPLETADO")
  fecha                       DateTime @default(now())

  pago       Pago        @relation(fields: [pagoId], references: [id], onDelete: Restrict)
  devolucion Devolucion? @relation(fields: [devolucionId], references: [id], onDelete: SetNull)

  @@map("reembolsos")
}

// ==========================================
// DOMINIO 11: PROMOCIONES, CUPONES Y DESCUENTOS
// ==========================================

model Cupon {
  id                        String        @id @default(uuid())
  tiendaId                  String?
  codigo                    String        @unique
  descripcion               String?
  tipoDescuento             TipoDescuento @default(PORCENTAJE)
  valorDescuento            Decimal       @db.Decimal(10, 2)
  montoMinimoCompra         Decimal       @default(0.00) @db.Decimal(12, 2)
  descuentoMaximoPermitido  Decimal?      @db.Decimal(12, 2)
  limiteUsosTotal           Int?
  limiteUsosPorUsuario      Int           @default(1)
  usosActuales              Int           @default(0)
  fechaInicio               DateTime
  fechaFin                  DateTime
  estado                    Boolean       @default(true)

  tienda Tienda?    @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  usos   CuponUso[]

  @@index([codigo])
  @@map("cupones")
}

model CuponUso {
  id               String   @id @default(uuid())
  cuponId          String
  usuarioId        String
  pedidoId         String
  descuentoAplicado Decimal @db.Decimal(12, 2)
  fechaUso         DateTime @default(now())

  cupon   Cupon   @relation(fields: [cuponId], references: [id], onDelete: Restrict)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@unique([cuponId, usuarioId, pedidoId])
  @@index([cuponId])
  @@index([usuarioId])
  @@map("cupones_usos")
}

model Promocion {
  id          String              @id @default(uuid())
  nombre      String
  descripcion String?
  tipo        TipoDescuento       @default(PORCENTAJE)
  valor       Decimal             @db.Decimal(10, 2)
  fechaInicio DateTime
  fechaFin    DateTime
  estado      Boolean             @default(true)
  productos   PromocionProducto[]

  @@map("promociones")
}

model PromocionProducto {
  id          String  @id @default(uuid())
  promocionId String
  productoId  String
  varianteId  String?

  promocion Promocion @relation(fields: [promocionId], references: [id], onDelete: Cascade)

  @@map("promociones_productos")
}

// ==========================================
// DOMINIO 12: RESEÑAS, CALIFICACIONES Y FAVORITOS
// ==========================================

model ResenaProducto {
  id                 String   @id @default(uuid())
  usuarioId          String
  productoId         String
  pedidoItemId       String   @unique
  calificacion       Int
  titulo             String?
  comentario         String?
  esCompraVerificada Boolean  @default(true)
  estado             Boolean  @default(true)
  fecha              DateTime @default(now())

  usuario    Usuario    @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  producto   Producto   @relation(fields: [productoId], references: [id], onDelete: Cascade)
  pedidoItem PedidoItem @relation(fields: [pedidoItemId], references: [id], onDelete: Restrict)

  @@index([productoId])
  @@map("resenas_productos")
}

model ResenaTienda {
  id           String   @id @default(uuid())
  usuarioId    String
  tiendaId     String
  subPedidoId  String   @unique
  calificacion Int
  comentario   String?
  estado       Boolean  @default(true)
  fecha        DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  tienda  Tienda  @relation(fields: [tiendaId], references: [id], onDelete: Cascade)

  @@index([tiendaId])
  @@map("resenas_tiendas")
}

model ListaDeseos {
  id            String            @id @default(uuid())
  usuarioId     String
  nombre        String            @default("Favoritos")
  esPublica     Boolean           @default(false)
  fechaCreacion DateTime          @default(now())

  usuario Usuario           @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  items   ListaDeseosItem[]

  @@index([usuarioId])
  @@map("listas_deseos")
}

model ListaDeseosItem {
  id            String   @id @default(uuid())
  listaDeseosId String
  productoId    String
  varianteId    String?
  fechaAgregado DateTime @default(now())

  listaDeseos ListaDeseos @relation(fields: [listaDeseosId], references: [id], onDelete: Cascade)

  @@index([listaDeseosId])
  @@map("listas_deseos_items")
}

// ==========================================
// DOMINIO 13: COMUNICACIÓN, MENSAJERÍA Y NOTIFICACIONES
// ==========================================

model PreguntaProducto {
  id         String   @id @default(uuid())
  productoId String
  usuarioId  String
  pregunta   String
  estado     Boolean  @default(true)
  fecha      DateTime @default(now())

  producto  Producto            @relation(fields: [productoId], references: [id], onDelete: Cascade)
  usuario   Usuario             @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  respuesta RespuestaPregunta?

  @@index([productoId])
  @@map("preguntas_productos")
}

model RespuestaPregunta {
  id         String   @id @default(uuid())
  preguntaId String   @unique
  usuarioId  String
  respuesta  String
  fecha      DateTime @default(now())

  pregunta PreguntaProducto @relation(fields: [preguntaId], references: [id], onDelete: Cascade)
  usuario  Usuario          @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@map("respuestas_preguntas")
}

model Conversacion {
  id            String   @id @default(uuid())
  compradorId   String
  tiendaId      String
  subPedidoId   String?
  estado        Boolean  @default(true)
  fechaCreacion DateTime @default(now())

  tienda   Tienda    @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  mensajes Mensaje[]

  @@index([compradorId])
  @@index([tiendaId])
  @@map("conversaciones")
}

model Mensaje {
  id                 String   @id @default(uuid())
  conversacionId     String
  remitenteUsuarioId String
  contenido          String
  tipoContenido      String   @default("TEXTO")
  leido              Boolean  @default(false)
  fechaEnvio         DateTime @default(now())

  conversacion     Conversacion @relation(fields: [conversacionId], references: [id], onDelete: Cascade)
  remitenteUsuario Usuario      @relation(fields: [remitenteUsuarioId], references: [id], onDelete: Restrict)

  @@index([conversacionId])
  @@map("mensajes")
}

model Notificacion {
  id            String            @id @default(uuid())
  usuarioId     String
  canal         CanalNotificacion @default(IN_APP)
  tipoEvento    String
  titulo        String
  cuerpo        String
  enlaceDestino String?
  leida         Boolean           @default(false)
  fechaCreacion DateTime          @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("notificaciones")
}

// ==========================================
// DOMINIO 14: CONFIGURACIÓN DEL SISTEMA Y AUDITORÍA
// ==========================================

model Configuracion {
  id                 String   @id @default(uuid())
  clave              String   @unique
  valor              String
  tipoDato           String   @default("STRING")
  grupo              String   @default("GENERAL")
  descripcion        String?
  esEditable         Boolean  @default(true)
  fechaActualizacion DateTime @updatedAt

  @@index([clave])
  @@map("configuraciones")
}

model Auditoria {
  id            String   @id @default(uuid())
  usuarioId     String?
  modulo        String
  accion        String
  entidad       String
  entidadId     String?
  datosPrevios  Json?
  datosNuevos   Json?
  direccionIp   String?
  agenteUsuario String?
  fecha         DateTime @default(now())

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([usuarioId])
  @@index([modulo])
  @@index([entidad, entidadId])
  @@map("auditorias")
}
